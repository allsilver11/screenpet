{
  "capabilities": [
    {
      "identifier": "events",
      "description": "모든 창: 앱이 보내는 이벤트 듣기만 (창·앱을 다루는 API와 이벤트 보내기는 주지 않는다)",
      "windows": ["pet", "pet-*", "house", "guest-*", "pair", "code", "name", "link", "size", "letter", "ladder", "weather-*", "trail-*", "timeline", "object-*", "vehicle-*", "postit", "dodge", "sleigh", "feedback", "mailbox", "board", "opacity", "stats-ask", "stats"],
      "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
    },
    {
      "identifier": "floating-windows",
      "description": "떠 있는 창 모두: 👻 전체 투명도 듣기·묻기 (ui/opacity.js), 🔄 다시 읽힌 페이지가 듣기를 마쳤다고 알리기 (page_ready). 새 떠 있는 창(탈것 등)도 여기에 라벨을 넣는다",
      "windows": ["pet", "pet-*", "house", "guest-*", "object-*", "vehicle-*", "prop-*", "hand-*", "weather-*", "trail-*", "sleigh"],
      "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "allow-app-opacity", "allow-page-ready"]
    },
    {
      "identifier": "pet-windows",
      "windows": ["pet", "pet-*", "guest-*"],
      "permissions": ["allow-pointer-down", "allow-note-space", "allow-show-menu", "allow-slot-info", "allow-feed"]
    },
    {
      "identifier": "house-window",
      "windows": ["house"],
      "permissions": ["allow-house-click", "allow-house-drag-start", "allow-house-state", "allow-show-menu", "allow-slot-info", "allow-feed"]
    },
    {
      "identifier": "pair-window",
      "windows": ["pair"],
      "permissions": ["allow-pair-state", "allow-pair-answer"]
    },
    {
      "identifier": "code-window",
      "windows": ["code"],
      "permissions": ["allow-code-state", "allow-code-submit", "allow-code-renew", "allow-code-close"]
    },
    {
      "identifier": "name-window",
      "windows": ["name"],
      "permissions": ["allow-name-state", "allow-name-submit", "allow-name-close"]
    },
    {
      "identifier": "link-window",
      "windows": ["link"],
      "permissions": ["allow-link-state", "allow-link-submit", "allow-link-close", "allow-link-confirm"]
    },
    {
      "identifier": "size-window",
      "windows": ["size"],
      "permissions": ["allow-size-state", "allow-size-set", "allow-size-close"]
    },
    {
      "identifier": "mailbox-window",
      "windows": ["mailbox"],
      "permissions": ["allow-mailbox-state", "allow-mailbox-read", "allow-mailbox-done", "allow-mailbox-reject", "allow-mailbox-private", "allow-mailbox-photo", "allow-mailbox-delete", "allow-mailbox-block", "allow-mailbox-close"]
    },
    {
      "identifier": "opacity-window",
      "windows": ["opacity"],
      "permissions": ["allow-opacity-state", "allow-opacity-set", "allow-opacity-close"]
    },
    {
      "identifier": "board-window",
      "windows": ["board"],
      "permissions": ["allow-board-list", "allow-board-close"]
    },
    {
      "identifier": "stats-ask-window",
      "windows": ["stats-ask"],
      "permissions": ["allow-stats-answer"]
    },
    {
      "identifier": "stats-window",
      "windows": ["stats"],
      "permissions": ["allow-stats-list", "allow-stats-close"]
    },
    {
      "identifier": "feedback-window",
      "windows": ["feedback"],
      "permissions": ["allow-feedback-submit", "allow-feedback-close"]
    },
    {
      "identifier": "letter-window",
      "windows": ["letter"],
      "permissions": ["allow-letter-state", "allow-letter-submit", "allow-letter-close"]
    },
    {
      "identifier": "ladder-window",
      "windows": ["ladder"],
      "permissions": ["allow-ladder-state", "allow-ladder-host", "allow-ladder-begin", "allow-ladder-answer", "allow-ladder-close", "allow-ladder-seen"]
    },
    {
      "identifier": "timeline-window",
      "windows": ["timeline"],
      "permissions": ["allow-timeline-state", "allow-timeline-fit"]
    },
    {
      "identifier": "dodge-window",
      "windows": ["dodge"],
      "permissions": ["allow-dodge-state", "allow-dodge-keys", "allow-dodge-start", "allow-dodge-close"]
    },
    {
      "identifier": "object-windows",
      "windows": ["object-*"],
      "permissions": ["allow-object-down", "allow-object-menu"]
    },
    {
      "identifier": "vehicle-windows",
      "windows": ["vehicle-*"],
      "permissions": ["allow-vehicle-down", "allow-vehicle-menu"]
    },
    {
      "identifier": "postit-window",
      "windows": ["postit"],
      "permissions": ["allow-postit-max", "allow-postit-submit", "allow-postit-close"]
    }
  ]
}
